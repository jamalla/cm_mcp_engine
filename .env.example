# Every value is optional. The engine runs offline with none of them set.

# Where approved contracts come from. Most explicit wins:
#   1. CM_REGISTRY_FILE  - a registry.generated.json published by cm_mcp_contracts
#   2. CM_CONTRACTS_DIR  - a contracts directory (a cm_mcp_contracts checkout)
#   3. ../cm_mcp_contracts/contracts   - sibling checkout, auto-detected
#   4. ./registry.generated.json       - the version pinned into this repo
# CM_REGISTRY_FILE=
# CM_CONTRACTS_DIR=../cm_mcp_contracts/contracts

# Sends every upstream call to the local mock instead of the internet. The mock
# speaks the same envelope, so the generated code is identical either way.
DEV_OFFLINE=1

# Credentials for the upstreams in cm_engine/config.py's UPSTREAMS table. A
# contract names an upstream and never a token, so these live here and only here.
# Unset is fine offline -- the mock accepts any token, and the engine says so.
#
# Salla: create an app at salla.partners, install it on a development store, and
# copy that store's access token. Needed only with DEV_OFFLINE=0.
# SALLA_ACCESS_TOKEN=

MCP_HOST=127.0.0.1
MCP_PORT=8765
MOCK_API_PORT=8787
