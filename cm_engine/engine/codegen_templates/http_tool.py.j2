def build_path(args):
    path = PATH_TEMPLATE
    for mapping in PATH_PARAMS:
        if mapping["arg"] not in args:
            raise ToolError(f"missing path argument: {mapping['arg']}")
        # quote(safe="") so an id containing a slash cannot reshape the URL.
        path = path.replace(
            "{" + mapping["wire"] + "}", quote(str(args[mapping["arg"]]), safe="")
        )
    return BASE_URL.rstrip("/") + path


def build_query(args):
    """Query parameters as (name, value) pairs, honoring each one's style.

    Pairs rather than a dict because bracket and repeat styles send the same
    name more than once -- which is how Laravel-shaped upstreams take arrays.
    """
    pairs = []
    for spec in QUERY_PARAMS:
        if spec["has_constant"]:
            pairs.append((spec["wire"], spec["constant"]))
            continue

        value = args.get(spec["arg"])
        if value is None:
            continue

        style = spec["style"]
        if isinstance(value, (list, tuple)):
            if style == "bracket":
                pairs += [(spec["wire"] + "[]", item) for item in value]
            elif style == "repeat":
                pairs += [(spec["wire"], item) for item in value]
            elif style == "csv":
                pairs.append((spec["wire"], ",".join(str(item) for item in value)))
            else:
                raise ToolError(
                    f"query parameter {spec['wire']} takes a single value, got a list"
                )
        else:
            pairs.append((spec["wire"], value))
    return pairs


def build_body(args):
    if BODY_MODE == "none":
        return None
    if BODY_MODE == "mapped":
        return {
            mapping["wire"]: args[mapping["arg"]]
            for mapping in BODY_FIELDS
            if mapping["arg"] in args
        }
    # passthrough: whatever the path and query did not consume.
    return {k: v for k, v in args.items() if k not in CONSUMED_ARGS}


def dig(node, path):
    """Follow a dotted path, or None if it is not there."""
    for key in path:
        if not isinstance(node, dict) or key not in node:
            return None
        node = node[key]
    return node


def retryable(status, declared):
    """The contract's declaration wins; otherwise decide by class."""
    if declared is not None and "retryable" in declared:
        return bool(declared["retryable"])
    return status == 429 or status >= 500


def describe_failure(response):
    """Turn an upstream failure into something an agent can relay.

    The contract documented what each status means for THIS endpoint, so the
    caller hears "no category exists with this id" rather than a raw body.
    """
    status = response.status_code
    declared = ERROR_MEANINGS.get(str(status))

    try:
        body = response.json()
    except ValueError:
        body = None

    parts = [f"{CONTRACT}: {UPSTREAM} returned {status}"]

    if declared:
        parts.append(declared["meaning"])
    else:
        parts.append("a status this contract does not document for this endpoint")

    message = dig(body, ERROR_MESSAGE_PATH)
    if isinstance(message, str) and message:
        parts.append(f'upstream said: "{message}"')

    fields = dig(body, ERROR_FIELDS_PATH)
    if isinstance(fields, dict) and fields:
        detail = "; ".join(
            f"{name}: {problem[0] if isinstance(problem, list) and problem else problem}"
            for name, problem in fields.items()
        )
        parts.append(f"invalid fields -- {detail}")

    if status == 401 and SCOPES:
        parts.append(f"this endpoint needs the {', '.join(SCOPES)} scope")

    if retryable(status, declared):
        parts.append("retrying the call unchanged may succeed")

    return " -- ".join(parts)


def project(value):
    """Keep only the fields the contract promised.

    A chatty upstream adding a field does not leak it to the caller, and the
    agent sees the shape it was told to expect.
    """
    if not RESPONSE_FIELDS or not isinstance(value, dict):
        return value
    return {k: v for k, v in value.items() if k in RESPONSE_FIELDS}


def shape(payload):
    """Unwrap the envelope the contract declared and shape what is inside."""
    node = payload
    for key in DATA_PATH:
        if not isinstance(node, dict) or key not in node:
            raise ToolError(
                f"{CONTRACT}: the response has no {'.'.join(DATA_PATH)} -- "
                f"the upstream envelope is not the one the contract declared"
            )
        node = node[key]

    if not COLLECTION:
        return project(node)

    items = node if isinstance(node, list) else [node]
    result = {"items": [project(item) for item in items], "count": len(items)}
    if PAGINATION == "standard" and isinstance(payload, dict):
        # Sits beside the data in the envelope, not inside it -- and is projected
        # for the same reason the items are.
        page = payload.get("pagination")
        if isinstance(page, dict):
            result["pagination"] = {k: page[k] for k in PAGINATION_FIELDS if k in page}
    return result


