{
  "$schema": "../schema/tool-contract.v1.json",
  "contractVersion": "1.0.0",
  "kind": "multi-tool",

  "package": {
    "name": "partner_support",
    "title": "Partner Support Toolkit",
    "description": "Small offline helpers a support agent reaches for constantly: shipping zone lookup and return-window checks.",
    "owner": "partner-support-team"
  },

  "tools": [
    {
      "interface": {
        "name": "lookup_shipping_zone",
        "title": "Look Up Shipping Zone",
        "description": "Maps a two-letter country code to the shipping zone used for delivery estimates.",
        "whenToUse": [
          "A delivery estimate is needed but only the country is known.",
          "The user asks which shipping zone a country falls into."
        ],
        "whenNotToUse": [
          "The country is already expressed as a zone -- pass it straight through."
        ],
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "countryCode": { "type": "string", "description": "ISO 3166-1 alpha-2 country code." }
            },
            "required": ["countryCode"],
            "additionalProperties": false
          }
        },
        "response": {
          "schema": {
            "type": "object",
            "properties": {
              "countryCode": { "type": "string" },
              "zone": { "type": "string" }
            },
            "required": ["countryCode", "zone"]
          },
          "ui": {
            "display": "card",
            "title": "Zone for {countryCode}",
            "primary": "{zone}"
          }
        }
      },
      "binding": { "type": "none", "handler": "builtin://lookup_shipping_zone" },
      "validation": {
        "rules": [
          {
            "field": "countryCode",
            "match": "^[A-Za-z]{2}$",
            "message": "countryCode must be a two-letter ISO country code, e.g. SA"
          }
        ]
      },
      "dependencies": [],
      "governance": {
        "annotations": { "readOnly": true, "destructive": false, "idempotent": true, "openWorld": false },
        "execution": { "mode": "direct", "humanApproval": "never" },
        "caching": { "cacheable": true, "keyBy": ["countryCode"], "ttlSeconds": 3600 }
      }
    },
    {
      "interface": {
        "name": "check_return_window",
        "title": "Check Return Window",
        "description": "Reports whether an order is still inside its return window given how many days ago it was delivered.",
        "whenToUse": [
          "The user asks whether they can still return or exchange an item.",
          "The number of days since delivery is known or can be inferred."
        ],
        "whenNotToUse": [
          "The order has not been delivered yet -- check the order status first."
        ],
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "daysSinceDelivery": { "type": "integer", "description": "Whole days since the order was delivered." },
              "category": { "type": "string", "description": "Product category: standard, electronics, or final_sale." }
            },
            "required": ["daysSinceDelivery"],
            "additionalProperties": false
          }
        },
        "response": {
          "schema": {
            "type": "object",
            "properties": {
              "eligible": { "type": "boolean" },
              "windowDays": { "type": "integer" },
              "daysRemaining": { "type": "integer" },
              "summary": { "type": "string" }
            },
            "required": ["eligible", "windowDays", "summary"]
          },
          "ui": {
            "display": "card",
            "title": "Return eligibility",
            "primary": "{summary}",
            "secondary": "Window: {windowDays} days"
          }
        }
      },
      "binding": { "type": "none", "handler": "builtin://check_return_window" },
      "dependencies": [],
      "governance": {
        "annotations": { "readOnly": true, "destructive": false, "idempotent": true, "openWorld": false },
        "execution": { "mode": "direct", "humanApproval": "never" },
        "caching": { "cacheable": true, "keyBy": ["daysSinceDelivery", "category"], "ttlSeconds": 600 }
      }
    }
  ]
}
