{
  "$schema": "../schema/tool-contract.v1.json",
  "contractVersion": "1.0.0",
  "kind": "single-tool",

  "interface": {
    "name": "get_order_status",
    "title": "Get Order Status",
    "description": "Returns the current fulfillment status of a single order by its ID.",
    "whenToUse": [
      "The user asks where an order is or whether it shipped.",
      "A concrete order ID is available."
    ],
    "whenNotToUse": [
      "No order ID is available -- search first.",
      "The user wants to modify or cancel the order (this tool is read-only)."
    ],
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "description": "Merchant order ID." }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "forbidden": ["internalUserId", "rawAuthToken"]
    },
    "response": {
      "schema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" },
          "status": { "type": "string" },
          "eta": { "type": "string" },
          "carrier": { "type": "string" }
        },
        "required": ["orderId", "status"]
      },
      "ui": {
        "display": "card",
        "title": "Order {orderId}",
        "primary": "{status}",
        "secondary": "ETA: {eta}"
      }
    }
  },

  "binding": {
    "type": "http",
    "http": {
      "baseUrl": "https://api.partner.example",
      "method": "GET",
      "path": "/v1/orders/{orderId}/status",
      "auth": { "type": "bearer", "secretRef": "PARTNER_ORDERS_TOKEN" },
      "timeoutMs": 5000
    }
  },

  "validation": {
    "rules": [
      {
        "field": "orderId",
        "match": "^ORD-[0-9]{6,}$",
        "message": "orderId must look like ORD-123456"
      }
    ]
  },

  "dependencies": [],

  "governance": {
    "annotations": { "readOnly": true, "destructive": false, "idempotent": true, "openWorld": true },
    "execution": { "mode": "direct", "humanApproval": "never" },
    "caching": { "cacheable": true, "keyBy": ["orderId"], "ttlSeconds": 300 }
  }
}
