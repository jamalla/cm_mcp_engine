{
  "$schema": "../schema/tool-contract.v1.json",
  "contractVersion": "1.0.0",
  "kind": "single-tool",

  "interface": {
    "name": "cancel_order",
    "title": "Cancel Order",
    "description": "Cancels an order that has not yet shipped. Returns a proposal first and mutates nothing until a human approves it.",
    "whenToUse": [
      "The user explicitly asks to cancel or stop an order.",
      "A concrete order ID is available and the order has not shipped."
    ],
    "whenNotToUse": [
      "The user only wants to know the status -- use get_order_status instead.",
      "The user is asking a hypothetical question about cancellation policy."
    ],
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "description": "Merchant order ID." },
          "reason": { "type": "string", "description": "Why the order is being cancelled." }
        },
        "required": ["orderId"],
        "additionalProperties": false
      },
      "forbidden": ["internalUserId", "rawAuthToken"]
    },
    "response": {
      "schema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" },
          "status": { "type": "string" },
          "cancelledAt": { "type": "string" }
        },
        "required": ["orderId", "status"]
      },
      "ui": {
        "display": "card",
        "title": "Order {orderId}",
        "primary": "{status}",
        "secondary": "Cancelled at {cancelledAt}"
      }
    }
  },

  "binding": {
    "type": "http",
    "http": {
      "baseUrl": "https://api.partner.example",
      "method": "POST",
      "path": "/v1/orders/{orderId}/cancel",
      "auth": { "type": "bearer", "secretRef": "PARTNER_ORDERS_TOKEN" },
      "timeoutMs": 5000
    }
  },

  "validation": {
    "rules": [
      {
        "field": "orderId",
        "match": "^ORD-[0-9]{6,}$",
        "message": "orderId must look like ORD-123456"
      }
    ]
  },

  "dependencies": [],

  "governance": {
    "annotations": { "readOnly": false, "destructive": true, "idempotent": false, "openWorld": true },
    "execution": { "mode": "propose-apply", "humanApproval": "required" },
    "caching": { "cacheable": false }
  }
}
